{
  "expo": {
    "name": "YoungLife",
    "slug": "younglife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.younglife.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E2A47",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.younglife.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "younglife",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы вы могли выбрать фото профиля."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
